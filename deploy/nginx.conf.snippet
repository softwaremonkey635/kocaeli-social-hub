# =============================================================================
# Kocaeli Social Hub — Nginx Server Block
# Domain root, static SPA, clean URLs
# =============================================================================

server {
    listen 80;
    listen [::]:80;
    server_name example.com www.example.com;

    # --- HTTPS redirect (uncomment after SSL is set up) ----------------------
    # return 301 https://$host$request_uri;

    root /var/www/html;   # or /home/user/public_html on cPanel
    index index.html;
    charset utf-8;

    # --- SPA fallback --------------------------------------------------------
    location / {
        try_files $uri $uri/ /index.html;
    }

    # --- Service worker: never cache -----------------------------------------
    location = /sw.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires 0;
        alias /var/www/html/sw.js;
    }

    # --- index.html: never cache ---------------------------------------------
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires 0;
        try_files $uri =404;
    }

    # --- Hashed assets (immutable, 1 year) -----------------------------------
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # --- Other static assets --------------------------------------------------
    location ~* \.(webmanifest|json|txt|xml|rss|atom)$ {
        expires 1h;
        add_header Cache-Control "public, max-age=3600";
        try_files $uri =404;
    }

    # --- Compression ----------------------------------------------------------
    gzip on;
    gzip_vary on;
    gzip_min_length 256;
    gzip_types
        text/html
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/manifest+json
        image/svg+xml
        application/font-woff2;

    # Brotli (if nginx is compiled with brotli module)
    # brotli on;
    # brotli_types text/html text/plain text/css text/javascript
    #              application/javascript application/json application/manifest+json
    #              image/svg+xml application/font-woff2;

    # --- MIME types -----------------------------------------------------------
    types {
        application/manifest+json   webmanifest;
        application/json            json;
    }

    # --- Security headers -----------------------------------------------------
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # --- CSP (adjust if new third-party APIs are added) -----------------------
    add_header Content-Security-Policy "\
        default-src 'self'; \
        script-src 'self' 'unsafe-inline' 'unsafe-eval' https://scanner.tradingview.com https://www.googletagmanager.com https://www.google-analytics.com; \
        style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; \
        font-src 'self' https://fonts.gstatic.com; \
        img-src 'self' data: blob: https://finans.truncgil.com https://open-meteo.com https://api.open-meteo.com https://open.er-api.com https://www.google-analytics.com; \
        connect-src 'self' https://finans.truncgil.com https://api.open-meteo.com https://open.er-api.com https://scanner.tradingview.com https://www.google-analytics.com; \
        frame-src https://scanner.tradingview.com; \
        manifest-src 'self'; \
        worker-src 'self'; \
        base-uri 'self'; \
        form-action 'self'\
    " always;

    # --- Protect hidden files -------------------------------------------------
    location ~ /\. {
        deny all;
    }
}

# --- HTTPS server block (uncomment after SSL is ready) -----------------------
# server {
#     listen 443 ssl http2;
#     listen [::]:443 ssl http2;
#     server_name example.com www.example.com;
#
#     ssl_certificate     /etc/ssl/certs/example.com.pem;
#     ssl_certificate_key /etc/ssl/private/example.com.key;
#
#     # ... paste the full block above here, with the HTTPS redirect removed ...
# }
