    "react-dom": "^19.0.1",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
